TUTU_MCP_URL=https://mcp.tutu.ru/mcp
TUTU_MCP_TIMEOUT_MS=14000
TUTU_MCP_MAX_ATTEMPTS=4
TUTU_MCP_MAX_PAGES=2
TUTU_MCP_CONCURRENCY=2
TUTU_SEARCH_LOOKBACK_DAYS=3
TUTU_MCP_CACHE_TTL_MS=120000
TUTU_MCP_STALE_TTL_MS=1200000

# Claude Sonnet 4.6 through Amazon Bedrock.
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Optional Telegram greeting bot. Keep the real token outside Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=https://mission.matrixon.org
# On EC2, prefer an encrypted Parameter Store secret instead of an environment token.
TELEGRAM_BOT_TOKEN_SSM_PARAMETER=/tutu-mission/telegram-bot-token
AWS_BEDROCK_TIMEOUT_MS=15000
AWS_BEDROCK_ENABLED=true

# Authentication option 1: Bedrock API key
AWS_BEARER_TOKEN_BEDROCK=

# Authentication option 2: standard AWS SDK credential chain
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
