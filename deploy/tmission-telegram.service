[Unit]
Description=tmission Telegram greeting bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/tmission/app
RuntimeDirectory=tmission-telegram
RuntimeDirectoryMode=0750
Environment=AWS_REGION=eu-central-1
Environment=TELEGRAM_BOT_TOKEN_SSM_PARAMETER=/tmission/telegram-bot-token
Environment=TELEGRAM_MINI_APP_URL=https://mission.matrixon.org
ExecStart=/usr/bin/node scripts/telegram-bot.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
